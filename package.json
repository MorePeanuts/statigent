{
  "name": "statigent",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "format": "biome check --write . && uv run ruff format python tests/python",
    "lint": "biome check . && uv run ruff check python tests/python && uv run ruff format --check python tests/python",
    "typecheck": "tsc --noEmit && next typegen web && tsc --noEmit -p web",
    "test": "bun test tests/unit && uv run pytest tests/python",
    "check": "bun run lint && bun run typecheck && bun run test",
    "test:integration": "bun test tests/integration && uv run pytest -m integration tests/python",
    "runtime": "bun src/cli.ts",
    "agent": "bun src/agent/cli.ts",
    "test:smoke:model": "bun src/agent/smoke.ts",
    "test:smoke:collaboration": "bun src/agent/collaboration-smoke.ts",
    "test:smoke:judge": "bun src/evaluation/judge-smoke.ts",
    "test:evaluation:upstream": "uv run pytest -m upstream tests/python",
    "test:modeling:upstream": "uv run pytest -m upstream tests/python/test_modeling_metrics_upstream.py tests/python/test_modeling_references.py tests/python/test_tabarena_metrics_upstream.py",
    "test:modeling:data": "uv run --group data pytest tests/python/test_modeling_dataset_v3.py tests/python/test_modeling_prepare_ds.py tests/python/test_modeling_prepare_tab.py",
    "test:modeling:scale": "uv run pytest -m scale tests/python/test_modeling_data_scale.py",
    "test:modeling:system": "uv run --project environments/tabarena --frozen --offline pytest -m upstream tests/python/test_tabarena_system.py",
    "evaluate": "bun src/evaluation/cli.ts",
    "test:evaluation:integration": "bun test tests/integration/evaluation-agents.test.ts",
    "modeling": "bun src/modeling/cli.ts",
    "test:smoke:modeling": "bun src/modeling/smoke.ts",
    "test:smoke:modeling-benchmarks": "bun src/evaluation/modeling-smoke.ts",
    "test:smoke:classification": "bun src/modeling/classification-smoke.ts",
    "test:smoke:script": "bun src/agent/script-smoke.ts",
    "test:smoke:baselines": "bun src/baselines/smoke.ts",
    "test:baselines:integration": "bun test tests/integration/baseline-*.test.ts",
    "workbench": "NEXT_TELEMETRY_DISABLED=1 bun --bun next dev web -H 127.0.0.1 -p ${WORKBENCH_PORT:-3100}",
    "workbench:build": "NEXT_TELEMETRY_DISABLED=1 bun --bun next build web",
    "workbench:start": "NEXT_TELEMETRY_DISABLED=1 bun --bun next start web -H 127.0.0.1 -p ${WORKBENCH_PORT:-3100}"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.4",
    "@types/bun": "1.3.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "commander": "15.0.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "zod": "4.6.7"
  }
}
